# ==============================================================================
# Ingestion Worker Container (Cloud Run Job: monaro-risk-sync-job)
# ==============================================================================
FROM python:3.13-slim

WORKDIR /app

# 1. Install Python packages first to leverage Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2. Copy application scripts and prompts (data is provided via GCS volume mount)
COPY prompts/ ./prompts/
COPY scripts/ ./scripts/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/app"
ENV DEFAULT_PROJECTS="monaro"

# Entrypoint runs the turnkey standalone Drive and Sheets sync script
ENTRYPOINT ["python", "scripts/sync_drive.py", "--project=monaro"]
