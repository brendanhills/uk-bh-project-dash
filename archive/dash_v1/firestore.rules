rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      // By default, require email verification if available, or just check signed-in
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRiskTicket(data) {
      return data.id is string && data.id.size() <= 32 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.status is string && data.status.size() <= 32
        && data.riskOwner is string && data.riskOwner.size() <= 100
        && data.bundle is string && data.bundle.size() <= 100
        && data.riskName is string && data.riskName.size() <= 200
        && data.riskDescription is string && data.riskDescription.size() <= 2000
        && data.causeDescription is string && data.causeDescription.size() <= 2000
        && data.causeCategory is string && data.causeCategory.size() <= 100
        && data.consequenceDescription is string && data.consequenceDescription.size() <= 2000
        && data.trend is string && data.trend.size() <= 32
        && data.priority is string && data.priority.size() <= 32
        && data.governanceLevel is string && data.governanceLevel.size() <= 100
        && (data.inherentLikelihood is int || data.inherentLikelihood is float) && data.inherentLikelihood >= 1 && data.inherentLikelihood <= 5
        && (data.inherentConsequence is int || data.inherentConsequence is float) && data.inherentConsequence >= 1 && data.inherentConsequence <= 5
        && (data.inherentRiskScore is int || data.inherentRiskScore is float) && data.inherentRiskScore >= 1 && data.inherentRiskScore <= 25
        && data.inherentRiskLevel is string && data.inherentRiskLevel.size() <= 32
        && data.treatmentOwner is string && data.treatmentOwner.size() <= 100
        && data.treatmentPlan is string && data.treatmentPlan.size() <= 2000
        && data.targetDate is string && data.targetDate.size() <= 32
        && (data.residualLikelihood is int || data.residualLikelihood is float) && data.residualLikelihood >= 1 && data.residualLikelihood <= 5
        && (data.residualConsequence is int || data.residualConsequence is float) && data.residualConsequence >= 1 && data.residualConsequence <= 5
        && (data.residualRiskScore is int || data.residualRiskScore is float) && data.residualRiskScore >= 1 && data.residualRiskScore <= 25
        && data.residualRiskLevel is string && data.residualRiskLevel.size() <= 32
        && data.dateRaised is string && data.dateRaised.size() <= 32
        && data.userId is string && data.userId.size() <= 128;
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isVerifiedUser() 
        && isValidId(ticketId)
        && isValidRiskTicket(incoming())
        && isOwner(incoming().userId);

      allow update: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidRiskTicket(incoming())
        && isOwner(existing().userId)
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isVerifiedUser()
        && isOwner(existing().userId);
    }
  }
}
