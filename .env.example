# ==============================================================================
# F-DSE Risk Intelligence Platform — Environment Configuration
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# --- AI Studio / Gemini API Configuration ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:9000"

# --- Cloud Run Deployment Configuration ---
GCP_PROJECT_ID="uk-bh-experiments-argolis"
GCP_REGION="us-central1"
GCP_SERVICE_NAME="f-dse-risk-dashboard-private"

# --- Dashboard Viewer Access Control (IAM Roles/Run.Invoker) ---
# DASHBOARD_VIEWER_GROUPS: Comma-separated list of Google Groups granted viewer access
# Example: "f-dse-governance-team@google.com,my-team@twosync.google.com"
DASHBOARD_VIEWER_GROUPS=""

# DASHBOARD_VIEWER_USERS: Comma-separated list of individual user accounts granted viewer access
# Example: "brendanhills@google.com,colleague1@google.com"
DASHBOARD_VIEWER_USERS="brendanhills@google.com"

# BLOCKED_DOMAINS: Comma-separated list of domains strictly forbidden from viewer access
BLOCKED_DOMAINS="altostrat.com"
