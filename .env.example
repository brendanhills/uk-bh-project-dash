# ==============================================================================
# PROJECT DASHBOARD — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and configure your environment settings:
#   cp .env.example .env

# --- 1. Google Gemini AI & Model Configuration ---
# Google Cloud ADC (Recommended for enterprise / corporate environments):
# Run: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Or Gemini Developer API Key (Google AI Studio fallback):
# GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection:
GEMINI_MODEL=gemini-3.5-flash
TTS_MODEL=gemini-3.5-flash

# --- 2. Project Ingestion & Active Dataset ---
# Comma-separated list of projects to process during ingest_data.py
DEFAULT_PROJECTS=sample

# Active project slug for the local development server (fallback: sample)
DEFAULT_PROJECT=sample

# --- 3. Local Server Configuration ---
PORT=9000
HOST=0.0.0.0
